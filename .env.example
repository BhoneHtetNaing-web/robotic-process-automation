APP_NAME=ApexiveAI MPT Automation Platform
APP_ENV=development
API_PREFIX=/api/v1

# PostgreSQL connection. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://apexive_user:CHANGE_ME@localhost:5432/apexive_mpt

# Generate separate random secrets before running.
CONTROL_API_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
WEBHOOK_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS

# Do not configure an invented MPT endpoint.
MPT_SOURCE_STATUS=NOT_CONNECTED
MPT_API_BASE_URL=
MPT_API_TOKEN=

# Webhook replay protection
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300

# Keep all network-changing automation disabled until authorized.
NETWORK_WRITE_ACTIONS_ENABLED=false